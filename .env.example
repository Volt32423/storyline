# Copy this file to .env for local runs. On Render, set these in the dashboard.
# Never commit .env.

ANTHROPIC_API_KEY=
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=          # the imported Twilio number's id in Vapi
# Texting: fill in Sendblue OR Linq. If both are set, Sendblue is used.
SENDBLUE_API_KEY=              # Sendblue dashboard: API key (key id)
SENDBLUE_API_SECRET=           # Sendblue dashboard: API secret
SENDBLUE_PHONE_NUMBER=         # E.164; the Sendblue number (shared on the free plan)
# SENDBLUE_WEBHOOK_SECRET=     # normally derived from SHEETS_WEBAPP_SECRET; set only to override
LINQ_API_TOKEN=
LINQ_PHONE_NUMBER=             # E.164; the number people text photos to
LINQ_WEBHOOK_SECRET=           # for verifying Linq webhook signatures
FAMILY_PHONE_NUMBER=           # E.164; gets a text after each call. Must have texted Storyline's number once
                               # (on Sendblue's free plan, also be added as a verified contact).
SMS_SENDING_ENABLED=true       # turn off if sending texts misbehaves; reading texted photos still works
OPENWEATHER_API_KEY=
GRANDPA_NAME=Frank             # fictional
GRANDPA_CITY=Pittsburgh,US     # real city, used for the weather
BUILDER_NAME=Sam               # Frank's fictional grandson, who "set up" Storyline
SHEETS_WEBAPP_URL=             # the Apps Script web app URL, ending in /exec
SHEETS_WEBAPP_SECRET=          # same long random string as SECRET in apps_script/Code.gs
GOOGLE_SHEET_ID=               # the long id in the Sheet's URL, between /d/ and /edit (for the view link)
DEMO_CODE=                     # judges type this to get a call; calls are off until it's set
MAX_CALLS_PER_DAY=15
PUBLIC_BASE_URL=               # the Render URL, no trailing slash; also turns on keep-awake
# KEEP_AWAKE_MINUTES=10        # optional: how often the app visits its own /health (0 = off)

# Optional: change the call's model or voice without touching code
# VAPI_MODEL_PROVIDER=anthropic
# VAPI_MODEL=claude-haiku-5-5
# VAPI_VOICE_PROVIDER=vapi
# VAPI_VOICE_ID=Leah
# VAPI_WEBHOOK_SECRET=         # normally derived from SHEETS_WEBAPP_SECRET; set only to override
